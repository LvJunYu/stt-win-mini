<Window x:Class="Stt.App.TextShortcuts.TextShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="whisper Text Shortcuts"
        Icon="/Assets/whisper.ico"
        Width="560"
        Height="560"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#E6ECE4">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Border CornerRadius="18"
                Background="#FFFDF7"
                BorderBrush="#D6DECE"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Bottom"
                        Padding="22,14,22,18"
                        BorderBrush="#E4EADF"
                        BorderThickness="0,1,0,0"
                        Background="#FFFDF7">
                    <Grid>
                        <Button HorizontalAlignment="Left"
                                Padding="14,8"
                                Command="{Binding AddCommand}"
                                Background="#E7ECE3"
                                BorderBrush="#CDD8C7"
                                Foreground="#203126"
                                Content="Add shortcut" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Padding="16,8"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelCommand}"
                                    Background="#E7ECE3"
                                    BorderBrush="#CDD8C7"
                                    Foreground="#203126"
                                    Content="Cancel" />
                            <Button Padding="18,8"
                                    Command="{Binding SaveCommand}"
                                    Background="#203126"
                                    BorderBrush="#203126"
                                    Foreground="#FFFDF7"
                                    Content="Save" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,22,22,18">
                        <TextBlock Text="Text shortcuts"
                                   Foreground="#33453A"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#617362"
                                   TextWrapping="Wrap"
                                   Text="Press a hotkey anywhere to type its text into the focused field. Text is typed directly, not pasted, so it never goes through the clipboard." />

                        <TextBlock Margin="0,18,0,0"
                                   Foreground="#617362"
                                   Text="No shortcuts yet. Use Add shortcut to create one.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasShortcuts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,18,0,0"
                                            Padding="14"
                                            CornerRadius="14"
                                            Background="#EEF3EB"
                                            BorderBrush="#D7E1D2"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center"
                                                           Text="Name"
                                                           Foreground="#33453A"
                                                           FontWeight="SemiBold" />
                                                <Button Grid.Column="1"
                                                        Padding="12,4"
                                                        Command="{Binding RemoveCommand}"
                                                        Background="#E7ECE3"
                                                        BorderBrush="#CDD8C7"
                                                        Foreground="#203126"
                                                        Content="Remove" />
                                            </Grid>
                                            <TextBox Margin="0,8,0,0"
                                                     Padding="12,8"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#FFFDF7"
                                                     BorderBrush="#CCD7C5"
                                                     Foreground="#162018" />

                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Hotkey (click, then press the keys; Backspace clears)"
                                                       Foreground="#33453A"
                                                       FontWeight="SemiBold" />
                                            <TextBox Margin="0,8,0,0"
                                                     Padding="12,8"
                                                     IsReadOnly="True"
                                                     Text="{Binding Hotkey, Mode=OneWay}"
                                                     PreviewKeyDown="HotkeyTextBox_OnPreviewKeyDown"
                                                     PreviewTextInput="HotkeyTextBox_OnPreviewTextInput"
                                                     Background="#FFFDF7"
                                                     BorderBrush="#CCD7C5"
                                                     Foreground="#162018" />

                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Text to type"
                                                       Foreground="#33453A"
                                                       FontWeight="SemiBold" />
                                            <Grid Margin="0,8,0,0">
                                                <TextBox Padding="12,8"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MaxHeight="120"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="#FFFDF7"
                                                         BorderBrush="#CCD7C5"
                                                         Foreground="#162018">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <PasswordBox Padding="12,8"
                                                             Visibility="{Binding IsSecret, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                             Loaded="SecretPasswordBox_OnLoaded"
                                                             IsVisibleChanged="SecretPasswordBox_OnIsVisibleChanged"
                                                             PasswordChanged="SecretPasswordBox_OnPasswordChanged"
                                                             Background="#FFFDF7"
                                                             BorderBrush="#CCD7C5"
                                                             Foreground="#162018" />
                                            </Grid>
                                            <CheckBox Margin="0,10,0,0"
                                                      IsChecked="{Binding IsSecret}"
                                                      Foreground="#203126"
                                                      Content="Hide text (for passwords)" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="14"
                                Background="#EEF3EB"
                                BorderBrush="#D7E1D2"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Shortcuts file (encrypted for your Windows account)"
                                           Foreground="#33453A"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FilePath, Mode=OneWay}"
                                           Foreground="#617362"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
